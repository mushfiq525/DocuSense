# Google AI Studio — free tier, no credit card: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Groq — free tier fallback, no credit card: https://console.groq.com/keys
GROQ_API_KEY=groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
SIMILARITY_THRESHOLD=0.6

CHROMA_DIR=./chroma_db
COLLECTION_NAME=docusense
SOURCE_MD_PATH=docs/source.md